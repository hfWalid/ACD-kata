# Template for make local-env, which generates a password only for a missing file.
# Never copy this template over an existing local configuration.
# Use a local-only password; never use EDF or personal production credentials.
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=55432

# Optional local overrides; the defaults in application.yml are used when absent.
# KAFKA_PORT=9092
# SERVER_PORT=8081
# REVIEW_SERVER_PORT=8082
