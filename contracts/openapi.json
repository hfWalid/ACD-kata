    "/api/imports" : {
      "post" : {
        "tags" : [ "Imports" ],
        "summary" : "Import a CSV or JSON file",
        "description" : "Maps the file with the spec declared for the source, then runs the existing commands for each record. A record refused by the domain is reported with its code; the other records are still imported.",
        "operationId" : "importFile",
        "parameters" : [ {
          "name" : "X-User",
          "in" : "header",
          "description" : "Author identifier for this local kata; not authentication",
          "required" : true,
          "schema" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          }
        }, {
          "name" : "X-Approver",
          "in" : "header",
          "description" : "Actor recorded on approvals; the author when omitted",
          "required" : false,
          "schema" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          }
        }, {
          "name" : "source",
          "in" : "query",
          "description" : "Import source, which selects the mapping under contracts/import",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "mode",
          "in" : "query",
          "description" : "DRAFT, SUBMITTED or APPROVED",
          "required" : false,
          "schema" : {
            "type" : "string",
            "default" : "DRAFT"
          }
        }, {
          "name" : "dryRun",
          "in" : "query",
          "description" : "Simulate the workflow without writing anything",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        } ],
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "required" : [ "file" ],
                "type" : "object",
                "properties" : {
                  "file" : {
                    "type" : "string",
                    "format" : "binary"
                  }
                }
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "Import report",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ImportReportResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Unknown source, unsupported format or unknown mode",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
