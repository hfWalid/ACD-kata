  "components" : {
    "schemas" : {
      "SectionRequest" : {
        "required" : [ "content", "title" ],
        "type" : "object",
        "properties" : {
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "content" : {
            "maxLength" : 100000,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "UpdateDocumentRequest" : {
        "required" : [ "expectedVersion", "sections", "title" ],
        "type" : "object",
        "properties" : {
          "expectedVersion" : {
            "minimum" : 0,
            "exclusiveMinimum" : true,
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
