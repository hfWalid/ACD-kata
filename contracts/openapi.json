  "components" : {
    "schemas" : {
      "SectionRequest" : {
        "required" : [ "content", "title" ],
        "type" : "object",
        "properties" : {
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "content" : {
            "maxLength" : 100000,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "UpdateDocumentRequest" : {
        "required" : [ "expectedVersion", "sections", "title" ],
        "type" : "object",
        "properties" : {
          "expectedVersion" : {
            "minimum" : 0,
            "exclusiveMinimum" : true,
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "sections" : {
            "maxItems" : 50,
            "minItems" : 0,
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SectionRequest"
            }
          }
        }
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "title" : {
            "type" : "string",
            "nullable" : true
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string",
            "nullable" : true
          },
          "instance" : {
            "type" : "string",
            "format" : "uri",
            "nullable" : true
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "object"
            },
            "nullable" : true
          }
        }
      },
      "CreateDocumentRequest" : {
        "required" : [ "sections", "templateRef", "title" ],
        "type" : "object",
        "properties" : {
          "templateRef" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "sections" : {
            "maxItems" : 50,
            "minItems" : 0,
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SectionRequest"
            }
          }
        }
      },
      "AuditEntryResponse" : {
        "type" : "object",
        "properties" : {
          "version" : {
            "type" : "integer",
            "format" : "int64"
          },
          "action" : {
            "type" : "string"
          },
          "author" : {
            "type" : "string"
          },
          "occurredAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "DocumentResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "templateRef" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "sections" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SectionResponse"
            }
          },
          "status" : {
            "type" : "string"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "auditTrail" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AuditEntryResponse"
            }
          }
        }
      },
      "SectionResponse" : {
        "type" : "object",
        "properties" : {
          "title" : {
            "type" : "string"
          },
          "content" : {
            "type" : "string"
          }
        }
      },
      "ChangeDocumentStatusRequest" : {
        "required" : [ "expectedVersion" ],
        "type" : "object",
        "properties" : {
          "expectedVersion" : {
            "minimum" : 0,
            "exclusiveMinimum" : true,
            "type" : "integer",
            "format" : "int64"
          }
        }
      }
    }
  }
